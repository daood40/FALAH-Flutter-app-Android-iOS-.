!.env.example
*.p8
*.pem
*.key
*.pfx
*.p12
*service-account*.json
*serviceaccount*.json
*credentials*.json
secrets/
keys/
outbox/

# ═══════════ قواعد البيانات ═══════════
# falah.db مبنيّةٌ من raw/ بـ`build.py` (٢٥٧ م.ب) — لا تُحفظ، تُبنى.
# app.db بيانات مستخدمين — لا تدخل مستودعًا بحالٍ.
falah.db
falah.db-*
app.db
app.db-*
*.sqlite
*.sqlite3
backups/

