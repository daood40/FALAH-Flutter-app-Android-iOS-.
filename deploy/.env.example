# ═══════════════ متغيّرات بيئة فلاح ═══════════════
#
#   cp .env.example .env && chmod 600 .env
#
# **لا قيمةَ حقيقيةً في هذا الملفّ.** ما هنا أمثلةٌ وحدود. والملفّ الحقيقيّ
# `.env` مستبعَدٌ من git ويجب أن يكون بصلاحية ٦٠٠ — والفحص الأمنيّ يتحقّق.
#
# القاعدة المكتوبة في `launch/CREDENTIALS.md`: لا يُقبل من صاحب المشروع
# كلمةُ مرور Apple ID ولا حساب جوجل ولا رمزُ تحقّقٍ ثنائيّ. المفاتيح
# المقبولة وحدها هي المفاتيح المحدودةُ الصلاحيةِ القابلةُ للسحب.
#
# كلّ اسمٍ هنا مستعملٌ فعلًا في الشيفرة — لا اسمَ مخترع. للتحقّق:
#   grep -rhoE 'os\.environ[.\[]' --include='*.py' .

# ─────────── البيئة ───────────
# «إنتاج» يُعلَن صراحةً ولا يُخمَّن. وإعلانه يُفعّل حارس الهجرات الهادمة:
# لا هجرةَ تعيد بناء جدولٍ إلا بنسخةٍ احتياطيةٍ **استُرجعت وتُحقّق منها**.
FALAH_ENV=production
# الخادم يفحص إعدادَه قبل الاستقبال. في الإنتاج تُشترط: FALAH_SECURE=1
# وFALAH_ORIGIN بـhttps، ومفتاحُ إدارةٍ لا يقلّ عن ٢٤ محرفًا إن وُجد،
# وجذرُ آبل إن ضُبطت مفاتيحه. والنقصُ يُسقط الإقلاع برمز ٧٨ لا يمضي صامتًا.
# مكان النسخ الاحتياطية وبياناتها الموقَّعة
FALAH_BACKUP_DIR=/data/backups

# ─────────── الخادم ───────────
PORT=8080
# طابور الإصغاء. الافتراضيّ في بايثون ٥ فقط، وكان يُسقط ٤٨ من ١٠٠ اتصالٍ
# متزامن قبل أن يُقرأ — رُفع إلى ١٢٨.
FALAH_LISTEN_BACKLOG=128
# سجلّات بوّابة الجودة حين تشغّل خادمها
# FALAH_GATE_LOGS=.gate-logs
# النطاق خلف الوكيل الأماميّ. يستعمله docker-compose في FALAH_ORIGIN
FALAH_DOMAIN=falah.example.com
# ١ = الكعكة لا تسافر إلا عبر HTTPS. **يجب أن يكون ١ في الإنتاج**
FALAH_SECURE=1
# نطاق الإنتاج: كل طلب تغييرٍ من مصدرٍ سواه يُرفض. اتركه فارغًا محلّيًّا
FALAH_ORIGIN=https://falah.example.com
# ١ حين يكون خلف وكيلٍ أماميّ يكتب X-Forwarded-For بنفسه ويمحو ما جاء من
# العميل (Caddy يفعل). **بدونه** يصير حدُّ التسجيل «لكل عنوان» حدًّا للعالم
# كلّه معًا. **ومعه بلا وكيل** يستطيع أيُّ عميلٍ انتحالَ عنوانه وتخطّي الحدّ.
FALAH_TRUST_PROXY=1

# ─────────── القواعد ───────────
# قاعدة المحتوى: نصوصٌ موثّقة تُقرأ ولا تُكتب. تُبنى بـ`make db`
FALAH_DB=/app/falah.db
# قاعدة التطبيق: مستخدمون ومشاريع وطابور. على حجمٍ دائم
FALAH_APP_DB=/data/app.db
# ١ = يُسمح بتشغيل الهجرات المصنَّفة هادمة. **اتركه غير محدَّد**، ولا تضعه
# إلا لتشغيلٍ يدويٍّ واحدٍ بعد نسخةٍ احتياطية
# FALAH_ALLOW_DESTRUCTIVE=

# ─────────── العامل والطابور ───────────
# ٠ في الإنتاج: التصيير في خدمة worker مستقلّة، لا داخل الخادم
# إقلاعٌ بلا قاعدة محتوى — **لخطِّ التكامل وحدَه، لا للإنتاج.**
#
# `falah.db` تُبنى من `raw/` (١٦٥ م.ب) ولا تدخل git، فالاستنساخُ النظيفُ
# لا يملكها واختباراتُ المصادقة لا تحتاجها. وبهذا الإعلان يقلع الخادمُ
# للمصادقة وحدَها.
#
# وليس تخفيفًا لحارس: `FALAH_ENV=production` يُبطله فلا يقلع خادمُ إنتاجٍ
# بلا محتوى بحال، و`/readyz` يبقى يردّ ٥٠٣ فلا يُوجَّه إليه حركةٌ حقيقيّة.
FALAH_ALLOW_NO_CONTENT=0
FALAH_INLINE_WORKER=0
FALAH_WORKERS=1
FALAH_WORKER_IDLE=1.0
# نبضة العامل على القرص، تسألها الحاوية في فحص حياته
# افتراضيًّا بجوار app.db — لا في /tmp
# FALAH_WORKER_BEAT=/data/worker.beat
FALAH_WORKER_BEAT_MAX=120
# عاملٌ صامتٌ أطولَ من هذا (ثوانٍ) يُعدّ منقطعًا وتعود مهمّته إلى الطابور
FALAH_JOB_STALE=300
# سقفُ زمن المهمّة الواحدة: ما تجاوزه يُقطع ولا يبقى «يجري» إلى الأبد
FALAH_JOB_TIMEOUT=600
# عمرُ سجلّ المهمّة المنتهية قبل كنسه (ثوانٍ). الملفّات المصدَّرة لا تُمسّ
FALAH_JOB_KEEP=604800
# محاولاتٌ إضافية بعد الأولى، للعطب العابر وحده
FALAH_MAX_RETRIES=2
# مهلة الإعادة تتضاعف: ٥ ثم ١٠ ثم ٢٠… بسقف
FALAH_BACKOFF=5
FALAH_BACKOFF_MAX=300

# ─────────── حدود الطلب وحدُّ المعدّل ───────────
# أكبرُ جسمِ طلبٍ يُقرأ. ما فوقه يُردّ ٤١٣ صراحةً لا يُرمى صامتًا.
FALAH_MAX_BODY=1000000
# حدُّ المعدّل على المكلف: العدد في الساعة، لكل مستخدم (والتسجيلُ لكل عنوان).
# **يُعدّ العملُ المقبول لا الطلب** — مئةُ نقرةٍ على الزرّ نفسه مهمّةٌ واحدة
# فتُحسب واحدة، فلا يُعاقَب تزامنٌ مشروع. ويُردّ التجاوز ٤٢٩ مع Retry-After.
FALAH_RATE_EXPORT=30
FALAH_RATE_VIDEO=15
FALAH_RATE_AGENT=300
FALAH_RATE_REGISTER=20
FALAH_RATE_FILE=600
# أكبرُ ملفِّ تلاوةٍ يُجلب للمقطع
FALAH_MAX_AUDIO_BYTES=25000000

# ─────────── حدود الموارد ───────────
# تمنع أن يخنق مستخدمٌ واحد الخدمة، أو أن تمتلئ الذاكرة والقرص
FALAH_MAX_QUEUED_PER_USER=5
FALAH_MAX_RUNNING=4
FALAH_MAX_CARDS_PER_JOB=60
FALAH_MAX_VIDEO_SECONDS=180
FALAH_MAX_STORAGE_MB_PER_USER=2048

# ─────────── الحساب والدخول ───────────
# إطلاقٌ مغلق: لا حساب إلا بهذا الرمز. افرغه لفتح التسجيل
FALAH_INVITE=
# مفتاح العمليات الإدارية (منح اشتراك، إيصالٌ موثوق). سرٌّ طويلٌ عشوائيّ:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FALAH_ADMIN_KEY=

# ─────────── البريد ───────────
FALAH_SMTP_HOST=
FALAH_SMTP_PORT=587
FALAH_SMTP_USER=
FALAH_SMTP_PASS=
FALAH_MAIL_FROM=falah@example.com

# ─────────── المتاجر ───────────
# **لا تضع هنا مفتاحًا حقيقيًّا.** المفاتيح الوحيدة المقبولة:
#   آبل  : In-App Purchase Key + App Store Connect API Key بدور App Manager
#          (لا Admin أبدًا)
#   جوجل: حساب خدمة بصلاحيات التطبيق وحده
#          (لا Account owner ولا Admin ولا Release to production)
FALAH_APPLE_BUNDLE_ID=com.example.falah
FALAH_APPLE_ISSUER_ID=
FALAH_APPLE_KEY_ID=
# مسارُ ملفّ .p8 خارج شجرة المصدر — لا محتواه، ولا داخل المستودع
FALAH_APPLE_KEY_P=/run/secrets/apple_key.p8
# شهادة جذر آبل. **بدونها يرفض المحقّق كلَّ إيصال** ولا يقبل شيئًا على عِلّاته
FALAH_APPLE_ROOT_CA=/run/secrets/AppleRootCA-G3.cer
FALAH_APPLE_ENV=production
FALAH_ANDROID_PACKAGE=com.example.falah
FALAH_GOOGLE_SA_JSON=/run/secrets/google-sa.json

# ─────────── متفرّقات ───────────
FALAH_CURRENCY=USD
# مسارُ ملفّ قرارات المراجعة الشرعية، إن وُجد
FALAH_RULINGS=
